{
  // Cloudflare Worker + static assets — same hosting model as the EBO and License Ladder sites.
  // Workers Builds (dashboard): build command `npm run build`, deploy command `npx wrangler deploy`.
  // `next build` writes the static export to ./out (see next.config.ts); the Worker serves it and
  // handles the two form endpoints.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edcloud-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
  // Secrets (dashboard: Workers & Pages → edcloud-website → Settings → Variables and Secrets):
  //   RESEND_API_KEY  — required for the contact and newsletter forms (resend.com; verify edcloud.org there)
  // Optional plain-text vars:
  //   CONTACT_TO      — inbox that receives form submissions      (default info@edcloud.org)
  //   CONTACT_FROM    — verified sender                            (default "EdCloud Website <website@edcloud.org>")
  //   CANONICAL_HOST  — host to redirect the apex to               (default www.edcloud.org)
}
