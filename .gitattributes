# qa:content compares these byte for byte against what the server returns (LF); keep autocrlf off them.
scripts/qa/content-snapshot/** text eol=lf
*.png binary
# Served as-is by the static host and compared byte for byte by qa:content (/robots.txt), so a
# Windows checkout (core.autocrlf=true) must not turn them into CRLF.
public/robots.txt text eol=lf
public/_headers text eol=lf
public/_redirects text eol=lf
