/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; media-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Also covers the mobile crops in /images/m/ (scripts/images/build-crops.py). They get no rule of
# their own on purpose: every matching rule applies, so a second Cache-Control would be joined onto
# this one. And they are not immutable: a re-crop rewrites a file under the same name.
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

# The hero loop is a few megabytes and changes about never, so it should be fetched once.
/video/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=2592000

# The font files are content-stable: a new cut would ship under a new name. next/font used to put
# these under /_next/static, which is already immutable; self-hosting moved them out from under
# that rule, so they get their own.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
